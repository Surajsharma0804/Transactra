# ============================================================
# Transactra Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Application ──────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://transactra:transactra@db:5432/transactra
DATABASE_URL_SYNC=postgresql+psycopg://transactra:transactra@db:5432/transactra

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM Adapter ─────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_PRIMARY_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini

# ── Razorpay Test Mode ───────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Signing / Verification ───────────────────────────
MANDATE_SIGNING_SECRET=...

# ── Security ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=...
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
